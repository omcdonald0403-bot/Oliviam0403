<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Wireframe Layout</title>
    <link rel="stylesheet" href="Style.css">
</head>
<body>

    <div class="site-container">
        
        <!-- Logo Area -->
        <div class="logo-area">
            Logo
        </div>

        <!-- Banner Content Area -->
        <header class="info-banner">
            <p>This area is for informational graphics which describe in images what your site is about</p>
        </header>

        <!-- Dynamic Header Nav (Injected via nav.js) -->
        <nav class="header-nav" id="header-navigation"></nav>

        <!-- Dynamic Sidebar Nav (Injected via nav.js) -->
        <aside class="sidebar-nav" id="sidebar-navigation"></aside>

        <!-- Main Content Area -->
        <main class="main-content">
            <div class="hero-image-container">
                <h2>Hero image at top</h2>
            </div>

            <section class="content-body">
                <h1>MAbout me</h1>
                <p>ghghghg l;hg</p>
            </section>
        </main>

        <!-- Sticky Right Sidebar -->
        <aside class="sticky-sidebar">
            <h3>Sticky content such as</h3>
            <ul>
                <li>news items</li>
                <li>adverts</li>
                <li>offers</li>
                <li>general site info</li>
                <li>Social Networking icons</li>
            </ul>
            <div class="social-icons">
                <span>[Icon]</span>
                <span>[Icon]</span>
                <span>[Icon]</span>
            </div>
        </aside>

        <!-- Footer Area -->
        <footer class="site-footer">
            Footer: Contains copyright info, current year, primary links, contact, privacy statement, webmaster email address
        </footer>

    </div>

    <!-- Script loading for site navigation -->
    <script src="nav.js"></script>
</body>
</html>
